# ══════════════════════════════════════════════════════════════════════════════
# Life is Feudal: Your Own — Docker Environment
# Copy to .env and edit to taste.  Only uncomment what you want to change;
# defaults are shown after the = sign.
# ══════════════════════════════════════════════════════════════════════════════

# ── Database ──────────────────────────────────────────────────────────────────
DB_ROOT_PASSWORD=rootChangeme
DB_NAME=lif_1
DB_USER=lif
DB_PASSWORD=changeme

# ── Server Identity ───────────────────────────────────────────────────────────
SERVER_NAME=Life is Feudal Docker Server
SERVER_PASSWORD=
ADMIN_PASSWORD=
GAME_MODE=Sandbox                    # Sandbox | PermaDeath
IS_PRIVATE=0                         # 1 = hidden from server browser
GAME_PORT=28000
WORLD_ID=1
MAX_PLAYERS=64                       # 1–64

# ── Skills & Progression ─────────────────────────────────────────────────────
SKILLS_MULTIPLIER=10                 # 0.1–100   (1 = vanilla MMO rate)
CRAFTING_SKILLCAP=600                # 200–3000  (600 = vanilla)
COMBAT_SKILLCAP=400                  # 200–3000  (400 = vanilla)
MINOR_SKILLCAP=400                   # 200–3000  (400 = vanilla)
SKILL_PARENT_MODE=default            # default = vanilla | lowered = 0/10/30/45/60/100 | none = all zeroed

# ── World Simulation ─────────────────────────────────────────────────────────
OBJECT_DECAY_RATE=0                  # 0 = no decay; buildings in claims are protected
TERRAFORMING_SPEED=4                 # 0.1–60  (0.8 = vanilla tunneling speed)
CRAFTING_PERIOD=60                   # 1–3600  seconds per crafting tick
ANIMAL_BREED_PERIOD=60               # 1–600   minutes between breed checks
DAY_CYCLE=3                          # 0.5–24  real-life hours per in-game day
ANIMALS_COUNT=100                    # 0–100   animal spawn points (high = more load)

# ── Miscellaneous ────────────────────────────────────────────────────────────
MOVABLE_MAX_DROP_HEIGHT=5            # meters
RANDOM_EVENT_CHANCE_WALKING=0.03
RANDOM_EVENT_CHANCE_ABILITY=0.02
HORSE_DECAY_MINUTES=0                # 0 = disabled; minutes before unattended horses vanish
DROP_ON_PRAY=0                       # 1 = drop inventory on homecoming prayer

# ── Judgement Hour (guild warfare window) ─────────────────────────────────────
JH_START_TIME=00:00                  # HH:MM format
JH_DURATION=0                        # duration in real-life minutes (0 = disabled)
JH_MON=0
JH_TUE=0
JH_WED=0
JH_THU=0
JH_FRI=0
JH_SAT=0
JH_SUN=0

# ── Backups ──────────────────────────────────────────────────────────────────
BACKUP_ENABLED=true                  # true = hourly DB + config backups
BACKUP_INTERVAL=3600                 # seconds between backups (3600 = 1 hour)
BACKUP_KEEP=5                        # number of backups to retain

# ── Maintenance ───────────────────────────────────────────────────────────────
# Set "true" to auto-update via SteamCMD on every container start (~1-2 min).
UPDATE_ON_START=false
